diff --git a/bazel_overlay/boards/adafruit/feather_nrf52840/BUILD.bazel b/bazel_overlay/boards/adafruit/feather_nrf52840/BUILD.bazel
new file mode 100644
index 0000000..e9cfec8
--- /dev/null
+++ b/bazel_overlay/boards/adafruit/feather_nrf52840/BUILD.bazel
@@ -0,0 +1,145 @@
+# SPDX-License-Identifier: Apache-2.0
+#
+# Adafruit Feather nRF52840 Express. Board package for the Bazel build, modeled
+# on boards/nordic/nrf52833dk. Added for the Cantil firmware Bazel migration
+# (docs/roadmap/bazel-migration.md). Candidate for upstreaming to zephyr-bazel.
+#
+# Note the directory name (feather_nrf52840) is not the board name
+# (adafruit_feather_nrf52840); board.yml is authoritative and the transition's
+# resolve_board_id works off the discovery index, so platform ":nrf52840"
+# resolves via the SoC/variant rule to "adafruit_feather_nrf52840/nrf52840".
+#
+# Two platforms, because the variants are not interchangeable: the base target
+# uses the plain partition layout and has no CDC ACM node, while ":nrf52840_uf2"
+# uses the UF2/SoftDevice-v6 layout and pulls in cdc_acm_serial.dtsi. The uf2
+# variant is the one relevant to Cantil — the Feather, like the XIAO, is flashed
+# by dragging a .uf2 onto a mass-storage bootloader, and USB CDC needs the node.
+# The board's "sense" variants are not defined here; nothing targets them.
+
+load("@rules_cc//cc:defs.bzl", "cc_library")
+load("@zephyr//:defs.bzl", "dts_cc_library", "dts_library")
+load("@zephyr//:flags.bzl", "flags_from_dict")
+load("@zephyr-bazel//bazel:runner.bzl", "zephyr_runner_config")
+
+package(default_visibility = ["//visibility:public"])
+
+# Shared by both variants' .dts files.
+_COMMON_REFERENCES = [
+    "adafruit_feather_nrf52840_common.dtsi",
+    "adafruit_feather_nrf52840-pinctrl.dtsi",
+    "feather_connector.dtsi",
+    # SoC + shared Nordic dtsi (nrf52840_qiaa.dtsi and the partition layouts).
+    "@zephyr//dts/arm/nordic",
+    "@zephyr//dts/common",
+    "@zephyr//dts/vendor/nordic",
+    # input-event-codes.h.
+    "@zephyr//include:dt_bindings",
+]
+
+dts_library(
+    name = "devicetree_lib",
+    includes = [
+        "@zephyr//dts:dts_includes",
+        "@zephyr//include:include_includes",
+    ],
+    overlay = "adafruit_feather_nrf52840.dts",
+    references = _COMMON_REFERENCES,
+)
+
+dts_cc_library(
+    name = "devicetree_generated",
+    bindings = ["@zephyr//dts:bindings"],
+    dts_lib = ":devicetree_lib",
+    target_compatible_with = [":adafruit_feather_nrf52840"],
+)
+
+dts_library(
+    name = "devicetree_uf2_lib",
+    includes = [
+        "@zephyr//dts:dts_includes",
+        "@zephyr//include:include_includes",
+    ],
+    overlay = "adafruit_feather_nrf52840_nrf52840_uf2.dts",
+    references = _COMMON_REFERENCES + [
+        # cdc_acm_serial.dtsi, included as <../boards/common/usb/...>.
+        "@zephyr//boards:common_usb_dts",
+    ],
+)
+
+dts_cc_library(
+    name = "devicetree_uf2_generated",
+    bindings = ["@zephyr//dts:bindings"],
+    dts_lib = ":devicetree_uf2_lib",
+    target_compatible_with = [":adafruit_feather_nrf52840"],
+)
+
+constraint_value(
+    name = "adafruit_feather_nrf52840",
+    constraint_setting = "@zephyr//boards:board_name",
+)
+
+cc_library(
+    name = "hal_soc_headers_library",
+    deps = [
+        "@hal_nordic//:dt_interface",
+        "@zephyr//modules/hal_nordic/nrfx:nrfx_hdrs",
+    ],
+)
+
+zephyr_runner_config(
+    name = "nrf52840_runner",
+    args = [
+        "--device=nRF52840_xxAA",
+        "--speed=4000",
+    ],
+    runner = "jlink",
+)
+
+# The board has no CMakeLists sources.
+filegroup(
+    name = "feather_nrf52840_extra_srcs",
+    srcs = ["@zephyr//:empty_files"],
+)
+
+platform(
+    name = "nrf52840",
+    constraint_values = [
+        ":adafruit_feather_nrf52840",
+        "@platforms//cpu:armv7e-m",
+        "@zephyr//constraints/arm:cortex-m4",
+        "//boards:hw",
+    ],
+    flags = flags_from_dict({
+        "@zephyr//:board_runner_config": "@zephyr//boards/adafruit/feather_nrf52840:nrf52840_runner",
+        "@zephyr//:dts_cc_library": "@zephyr//boards/adafruit/feather_nrf52840:devicetree_generated",
+        "@zephyr//:hal_soc_extra_srcs": "@zephyr//boards/adafruit/feather_nrf52840:feather_nrf52840_extra_srcs",
+        "@zephyr//:hal_soc_headers_library": "@zephyr//boards/adafruit/feather_nrf52840:hal_soc_headers_library",
+        "@zephyr//:soc": "@zephyr//soc/nordic/nrf52",
+    }),
+    parents = ["@zephyr//platforms:cortex_m"],
+)
+
+# adafruit_feather_nrf52840/nrf52840/uf2 — resolve_board_id joins the qualifiers
+# with an underscore, so the platform name is "nrf52840_uf2".
+platform(
+    name = "nrf52840_uf2",
+    constraint_values = [
+        ":adafruit_feather_nrf52840",
+        "@platforms//cpu:armv7e-m",
+        "@zephyr//constraints/arm:cortex-m4",
+        "//boards:hw",
+    ],
+    flags = flags_from_dict({
+        "@zephyr//:board_runner_config": "@zephyr//boards/adafruit/feather_nrf52840:nrf52840_runner",
+        "@zephyr//:dts_cc_library": "@zephyr//boards/adafruit/feather_nrf52840:devicetree_uf2_generated",
+        "@zephyr//:hal_soc_extra_srcs": "@zephyr//boards/adafruit/feather_nrf52840:feather_nrf52840_extra_srcs",
+        "@zephyr//:hal_soc_headers_library": "@zephyr//boards/adafruit/feather_nrf52840:hal_soc_headers_library",
+        "@zephyr//:soc": "@zephyr//soc/nordic/nrf52",
+    }),
+    parents = ["@zephyr//platforms:cortex_m"],
+)
+
+alias(
+    name = "feather_nrf52840",
+    actual = ":nrf52840",
+)
diff --git a/bazel_overlay/boards/nordic/nrf52840dk/BUILD.bazel b/bazel_overlay/boards/nordic/nrf52840dk/BUILD.bazel
