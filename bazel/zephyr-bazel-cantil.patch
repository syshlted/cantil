+# SPDX-License-Identifier: GPL-3.0-or-later
+#
+# wolfSSL (wolfCrypt) for the Cantil firmware Bazel build
+# (docs/roadmap/bazel-migration.md, Phase 3). Overlaid onto the fetched wolfSSL
+# checkout via new_git_repository(build_file=...) in the Cantil MODULE.bazel.
+#
+# This is a *config-only* module from zephyr-bazel's point of view: there is no
+# `zephyr_module` target here, so discovery sources wolfSSL's Kconfig (for
+# CONFIG_WOLFSSL / WOLFSSL_BUILTIN / WOLFSSL_SETTINGS_FILE) but does NOT
+# auto-link its sources. The sources are compiled by //firmware:wolfssl, which
+# is where firmware/include (the cantil_wolfssl_user_settings.h that
+# CONFIG_WOLFSSL_SETTINGS_FILE names) is on the include path.
+#
+# The source list mirrors modules/crypto/wolfssl/zephyr/CMakeLists.txt exactly
+# (no glob — that CMakeLists enumerates every file, and several *.c under
+# wolfcrypt/src are #included rather than compiled). The FIPS, ARMASM and
+# INTELASM conditionals are all off for nRF52840 (WOLFCRYPT_ONLY, sp_cortexm.c
+# C-path), so their sources are omitted here.
+
+load("@rules_cc//cc:defs.bzl", "cc_library")
+
+package(default_visibility = ["//visibility:public"])
+
+# All wolfSSL / wolfCrypt public + internal headers. `includes` are the three
+# roots wolfSSL sources use: the module root (for "wolfssl/..." and
+# "wolfcrypt/..."), and zephyr/ (for the Zephyr port glue headers).
+cc_library(
+    name = "headers",
+    hdrs = glob([
+        "wolfssl/**/*.h",
+        "wolfcrypt/**/*.h",
+        "zephyr/**/*.h",
+    ]),
+    # wolfSSL amalgamates: many compiled units #include sibling .c/.i files by
+    # repo-relative path (ssl.c -> "src/ssl_misc.c"; tfm.c/sp_int.c -> *.i;
+    # several wolfcrypt units -> "misc.c"). Those are not compiled on their own
+    # (not in :srcs) but must be staged as textual inputs so the sandbox has
+    # them. Declaring them here makes them available to every wolfSSL compile.
+    textual_hdrs = glob(
+        [
+            "src/**/*.c",
+            "src/**/*.i",
+            "wolfcrypt/src/**/*.c",
+            "wolfcrypt/src/**/*.i",
+        ],
+        allow_empty = True,
+    ),
+    includes = [
+        ".",
+        "zephyr",
+    ],
+)
+
+# TLS/SSL layer (src/). Under WOLFCRYPT_ONLY these compile to essentially empty
+# translation units, but they are kept to match the reference CMake build.
+_SSL_SRCS = [
+    "src/crl.c",
+    "src/dtls.c",
+    "src/dtls13.c",
+    "src/internal.c",
+    "src/keys.c",
+    "src/ocsp.c",
