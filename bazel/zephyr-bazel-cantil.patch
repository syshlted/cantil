+# SPDX-License-Identifier: Apache-2.0
+#
+# Cantil Bazel migration (docs/roadmap/bazel-migration.md): the converter did
+# not generate a BUILD for lib/net_buf, so net_buf (buf.c / buf_simple.c) was
+# never compiled and the USB device_next stack failed to link with undefined
+# net_buf_* symbols. Mirrors lib/net_buf/CMakeLists.txt.
+
+load("//:cc.bzl", "zephyr_cc_library")
+
+package(default_visibility = ["//visibility:public"])
+
+zephyr_cc_library(
+    name = "net_buf",
+    srcs = select({
+        "@zephyr_kconfig//:CONFIG_NET_BUF=true": [
+            "buf.c",
+            "buf_simple.c",
+        ],
+        "//conditions:default": [],
+    }),
+)
