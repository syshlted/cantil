+++ b/bazel_overlay/boards/nordic/nrf52840dk/BUILD.bazel
@@ -0,0 +1,93 @@
+# SPDX-License-Identifier: Apache-2.0
+#
+# Nordic nRF52840 DK (PCA10056). Board package for the Bazel build, modeled on
+# boards/nordic/nrf52833dk. Added for the Cantil firmware Bazel migration
+# (docs/roadmap/bazel-migration.md). Candidate for upstreaming to zephyr-bazel.
+#
+# Only the nrf52840 SoC target is defined. board.yml also declares nrf52811
+# (the DK running the 52840 in nRF52811 emulation mode), which additionally
+# needs the DEVELOP_IN_NRF52840 / NRFX_COREDEP_DELAY_US_LOOP_CYCLES defines
+# from the board CMakeLists; nothing here targets it.
+
+load("@rules_cc//cc:defs.bzl", "cc_library")
+load("@zephyr//:defs.bzl", "dts_cc_library", "dts_library")
+load("@zephyr//:flags.bzl", "flags_from_dict")
+load("@zephyr-bazel//bazel:runner.bzl", "zephyr_runner_config")
+
+package(default_visibility = ["//visibility:public"])
+
+dts_library(
+    name = "devicetree_lib",
+    includes = [
+        "@zephyr//dts:dts_includes",
+        "@zephyr//include:include_includes",
+    ],
+    overlay = "nrf52840dk_nrf52840.dts",
+    references = [
+        "nrf52840dk_nrf52840-pinctrl.dtsi",
+        # SoC + shared Nordic dtsi (nrf52840_qiaa.dtsi, nrf52840_partition.dtsi).
+        "@zephyr//dts/arm/nordic",
+        "@zephyr//dts/common",
+        "@zephyr//dts/vendor/nordic",
+        # arduino-header-r3.h, input-event-codes.h.
+        "@zephyr//include:dt_bindings",
+    ],
+)
+
+dts_cc_library(
+    name = "devicetree_generated",
+    bindings = ["@zephyr//dts:bindings"],
+    dts_lib = ":devicetree_lib",
+    target_compatible_with = [":nordic_nrf52840dk"],
+)
+
+constraint_value(
+    name = "nordic_nrf52840dk",
+    constraint_setting = "@zephyr//boards:board_name",
+)
+
+cc_library(
+    name = "hal_soc_headers_library",
+    deps = [
+        "@hal_nordic//:dt_interface",
+        "@zephyr//modules/hal_nordic/nrfx:nrfx_hdrs",
+    ],
+)
+
+zephyr_runner_config(
+    name = "nrf52840_runner",
+    args = [
+        "--device=nRF52840_xxAA",
+        "--speed=4000",
+    ],
+    runner = "jlink",
+)
+
+# The board has no CMakeLists sources for the nrf52840 target.
+filegroup(
+    name = "nrf52840dk_extra_srcs",
+    srcs = ["@zephyr//:empty_files"],
+)
+
+platform(
+    name = "nrf52840",
+    constraint_values = [
+        ":nordic_nrf52840dk",
+        "@platforms//cpu:armv7e-m",
+        "@zephyr//constraints/arm:cortex-m4",
+        "//boards:hw",
+    ],
+    flags = flags_from_dict({
+        "@zephyr//:board_runner_config": "@zephyr//boards/nordic/nrf52840dk:nrf52840_runner",
+        "@zephyr//:dts_cc_library": "@zephyr//boards/nordic/nrf52840dk:devicetree_generated",
+        "@zephyr//:hal_soc_extra_srcs": "@zephyr//boards/nordic/nrf52840dk:nrf52840dk_extra_srcs",
+        "@zephyr//:hal_soc_headers_library": "@zephyr//boards/nordic/nrf52840dk:hal_soc_headers_library",
+        "@zephyr//:soc": "@zephyr//soc/nordic/nrf52",
+    }),
+    parents = ["@zephyr//platforms:cortex_m"],
+)
+
+alias(
+    name = "nrf52840dk",
+    actual = ":nrf52840",
+)
diff --git a/bazel_overlay/boards/nordic/nrf52840dongle/BUILD.bazel b/bazel_overlay/boards/nordic/nrf52840dongle/BUILD.bazel
new file mode 100644
index 0000000..8c490fc
--- /dev/null
+++ b/bazel_overlay/boards/nordic/nrf52840dongle/BUILD.bazel
@@ -0,0 +1,99 @@
+# SPDX-License-Identifier: Apache-2.0
+#
+# Nordic nRF52840 Dongle (PCA10059). Board package for the Bazel build, modeled
+# on boards/nordic/nrf52833dk. Added for the Cantil firmware Bazel migration
+# (docs/roadmap/bazel-migration.md). Candidate for upstreaming to zephyr-bazel.
+#
+# Only the default nrf52840 target is defined; board.yml also declares a "bare"
+# variant (no nRF5 bootloader offset), which needs its own .dts and platform.
+
+load("@rules_cc//cc:defs.bzl", "cc_library")
+load("@zephyr//:defs.bzl", "dts_cc_library", "dts_library")
+load("@zephyr//:flags.bzl", "flags_from_dict")
+load("@zephyr-bazel//bazel:runner.bzl", "zephyr_runner_config")
+
+package(default_visibility = ["//visibility:public"])
+
+dts_library(
+    name = "devicetree_lib",
+    includes = [
+        "@zephyr//dts:dts_includes",
+        "@zephyr//include:include_includes",
+    ],
+    overlay = "nrf52840dongle_nrf52840.dts",
+    references = [
+        # Local board dtsi pulled in by the .dts.
+        "nrf52840dongle_nrf52840_common.dtsi",
+        "nrf52840dongle_nrf52840-pinctrl.dtsi",
+        # SoC + shared Nordic dtsi (nrf52840_qiaa.dtsi).
+        "@zephyr//dts/arm/nordic",
+        "@zephyr//dts/common",
+        "@zephyr//dts/vendor/nordic",
+        # input-event-codes.h.
+        "@zephyr//include:dt_bindings",
+        # cdc_acm_serial.dtsi, included as <../boards/common/usb/...>.
+        "@zephyr//boards:common_usb_dts",
+    ],
+)
+
+dts_cc_library(
+    name = "devicetree_generated",
+    bindings = ["@zephyr//dts:bindings"],
+    dts_lib = ":devicetree_lib",
+    target_compatible_with = [":nordic_nrf52840dongle"],
+)
+
+constraint_value(
+    name = "nordic_nrf52840dongle",
+    constraint_setting = "@zephyr//boards:board_name",
+)
+
+cc_library(
+    name = "hal_soc_headers_library",
+    deps = [
+        "@hal_nordic//:dt_interface",
+        "@zephyr//modules/hal_nordic/nrfx:nrfx_hdrs",
+    ],
+)
+
+zephyr_runner_config(
+    name = "nrf52840_runner",
+    args = [
+        "--device=nRF52840_xxAA",
+        "--speed=4000",
+    ],
+    runner = "jlink",
+)
+
+# Unlike the DK, this board has a CMakeLists: board.c supplies
+# board_early_init_hook(), which raises REGOUT0 to 3.0 V so the LEDs light in
+# USB high-voltage mode. BOARD_NRF52840DONGLE selects BOARD_EARLY_INIT_HOOK and
+# kernel/init.c calls the hook unconditionally with no weak default, so omitting
+# this source is a link error rather than a silent behaviour change.
+filegroup(
+    name = "nrf52840dongle_extra_srcs",
+    srcs = ["board.c"],
+)
+
+platform(
+    name = "nrf52840",
+    constraint_values = [
+        ":nordic_nrf52840dongle",
+        "@platforms//cpu:armv7e-m",
+        "@zephyr//constraints/arm:cortex-m4",
+        "//boards:hw",
+    ],
+    flags = flags_from_dict({
+        "@zephyr//:board_runner_config": "@zephyr//boards/nordic/nrf52840dongle:nrf52840_runner",
+        "@zephyr//:dts_cc_library": "@zephyr//boards/nordic/nrf52840dongle:devicetree_generated",
+        "@zephyr//:hal_soc_extra_srcs": "@zephyr//boards/nordic/nrf52840dongle:nrf52840dongle_extra_srcs",
+        "@zephyr//:hal_soc_headers_library": "@zephyr//boards/nordic/nrf52840dongle:hal_soc_headers_library",
+        "@zephyr//:soc": "@zephyr//soc/nordic/nrf52",
+    }),
+    parents = ["@zephyr//platforms:cortex_m"],
+)
+
+alias(
+    name = "nrf52840dongle",
+    actual = ":nrf52840",
+)
diff --git a/bazel_overlay/boards/seeed/xiao_ble/BUILD.bazel b/bazel_overlay/boards/seeed/xiao_ble/BUILD.bazel
new file mode 100644
index 0000000..beec341
--- /dev/null
+++ b/bazel_overlay/boards/seeed/xiao_ble/BUILD.bazel
@@ -0,0 +1,117 @@
+# SPDX-License-Identifier: Apache-2.0
+#
+# Seeed Studio XIAO BLE (Sense) — nRF52840. Board package for the Bazel build,
+# modeled on boards/nordic/nrf52833dk. Added for the Cantil firmware Bazel
+# migration (docs/roadmap/bazel-migration.md). Candidate for upstreaming to
+# zephyr-bazel.
+
+load("@rules_cc//cc:defs.bzl", "cc_library")
+load("@zephyr//:defs.bzl", "dts_cc_library", "dts_library")
+load("@zephyr//:flags.bzl", "flags_from_dict")
+load("@zephyr-bazel//bazel:runner.bzl", "zephyr_runner_config")
+
+package(default_visibility = ["//visibility:public"])
+
+dts_library(
+    name = "devicetree_lib",
+    includes = [
+        "@zephyr//dts:dts_includes",
+        "@zephyr//include:include_includes",
+    ],
+    overlay = "xiao_ble_nrf52840_sense.dts",
+    references = [
+        # Local board dtsi pulled in by the sense .dts.
+        "xiao_ble_common.dtsi",
+        "xiao_ble-pinctrl.dtsi",
+        "seeed_xiao_connector.dtsi",
+        # SoC + shared Nordic dtsi (nrf52840_qiaa.dtsi, partition layout).
+        "@zephyr//dts/arm/nordic",
+        "@zephyr//dts/common",
+        "@zephyr//dts/vendor/nordic",
+        "@zephyr//include:dt_bindings",
+        # cdc_acm_serial.dtsi, included as <../boards/common/usb/...>.
+        "@zephyr//boards:common_usb_dts",
+    ],
+)
+
+dts_cc_library(
+    name = "devicetree_generated",
+    bindings = ["@zephyr//dts:bindings"],
+    dts_lib = ":devicetree_lib",
+    target_compatible_with = [":seeed_xiao_ble"],
+)
+
+constraint_value(
+    name = "seeed_xiao_ble",
+    constraint_setting = "@zephyr//boards:board_name",
+)
+
+cc_library(
+    name = "hal_soc_headers_library",
+    deps = [
+        "@hal_nordic//:dt_interface",
+        "@zephyr//modules/hal_nordic/nrfx:nrfx_hdrs",
+    ],
+)
+
+zephyr_runner_config(
+    name = "nrf52840_runner",
+    args = [
+        "--device=nRF52840_xxAA",
+        "--speed=4000",
+    ],
+    runner = "jlink",
+)
+
+filegroup(
+    name = "xiao_ble_extra_srcs",
+    srcs = ["@zephyr//:empty_files"],
+)
+
+platform(
+    name = "nrf52840",
+    constraint_values = [
+        ":seeed_xiao_ble",
+        "@platforms//cpu:armv7e-m",
+        "@zephyr//constraints/arm:cortex-m4",
+        "//boards:hw",
+    ],
+    flags = flags_from_dict({
+        "@zephyr//:board_runner_config": "@zephyr//boards/seeed/xiao_ble:nrf52840_runner",
+        "@zephyr//:dts_cc_library": "@zephyr//boards/seeed/xiao_ble:devicetree_generated",
+        "@zephyr//:hal_soc_extra_srcs": "@zephyr//boards/seeed/xiao_ble:xiao_ble_extra_srcs",
+        "@zephyr//:hal_soc_headers_library": "@zephyr//boards/seeed/xiao_ble:hal_soc_headers_library",
+        "@zephyr//:soc": "@zephyr//soc/nordic/nrf52",
+    }),
+    parents = ["@zephyr//platforms:cortex_m"],
+)
+
+# Sense variant (xiao_ble/nrf52840/sense) — the target Cantil builds for. The
+# transition's resolve_board_id maps this platform's name "nrf52840_sense" to
+# board_id "xiao_ble/nrf52840/sense" (underscore-joined qualifiers), so
+# BOARD_QUALIFIERS="nrf52840/sense" and the app's boards/*_sense.conf and
+# _sense.overlay are picked up. The base :nrf52840 platform above resolves to
+# the plain "xiao_ble/nrf52840" board and is kept for the smoke test. Both use
+# the same devicetree_generated (built from the sense .dts).
+platform(
+    name = "nrf52840_sense",
+    constraint_values = [
+        ":seeed_xiao_ble",
+        "@platforms//cpu:armv7e-m",
+        "@zephyr//constraints/arm:cortex-m4",
+        "//boards:hw",
+    ],
