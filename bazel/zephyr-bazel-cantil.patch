+# UF2 packaging — the Bazel equivalent of Zephyr CMake's CONFIG_BUILD_OUTPUT_UF2
+# post-build step. Boards whose only routine flashing route is a UF2 bootloader
+# (Adafruit nRF52 / RP2040 mass-storage bootloaders) otherwise produce no
+# flashable artifact from a Bazel build at all.
+#
+# Like _zephyr_app_elf, this carries the platform transition: the hex it
+# converts must be built in the app's own configuration, and the toolchain that
+# produces it only resolves inside that configuration.
+def _zephyr_app_uf2_impl(ctx):
+    hex_files = ctx.attr.hex[DefaultInfo].files.to_list()
+    if not hex_files:
+        fail("Hex target %s produced no files" % ctx.attr.hex.label)
+
+    out_file = ctx.actions.declare_file(ctx.label.name)
+
+    ctx.actions.run(
+        outputs = [out_file],
+        inputs = [hex_files[0]],
+        executable = ctx.executable._uf2conv,
