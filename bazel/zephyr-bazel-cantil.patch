diff --git a/bazel_overlay/modules/littlefs/BUILD.bazel b/bazel_overlay/modules/littlefs/BUILD.bazel
new file mode 100644
index 0000000..b7a61ef
--- /dev/null
+++ b/bazel_overlay/modules/littlefs/BUILD.bazel
@@ -0,0 +1,28 @@
+# SPDX-License-Identifier: Apache-2.0
+#
+# Zephyr in-tree glue for littlefs, exposed to the Cantil Bazel build
+# (docs/roadmap/bazel-migration.md). This dir (@zephyr//modules/littlefs) holds
+# the Zephyr-side half of littlefs — zephyr_lfs_config.h (the LFS_CONFIG header)
+# and zephyr_lfs_crc.c — while the portable library (lfs.c/lfs_util.c) is the
+# external @littlefs repo. zephyr-bazel's converter does not generate a BUILD
+# here, so this overlay adds one. //firmware:littlefs consumes both halves.
+
+load("@rules_cc//cc:defs.bzl", "cc_library")
+
+package(default_visibility = ["//visibility:public"])
+
+# The LFS_CONFIG header. Provides the include path and the define that lfs.h /
+# lfs_util.h expand, so any target compiling littlefs sources depends on this.
+cc_library(
+    name = "lfs_config",
+    hdrs = ["zephyr_lfs_config.h"],
+    defines = ["LFS_CONFIG=zephyr_lfs_config.h"],
+    includes = ["."],
+    # Header-only Zephyr target (log.h, __assert.h) rather than the @zephyr
+    # umbrella — subsys/fs depends on this, and the umbrella would cycle.
+    deps = ["@zephyr//include:zephyr"],
+)
+
+# Zephyr's CRC glue (zephyr_lfs_crc.c), compiled by //firmware:littlefs which
+# supplies lfs_util.h (from @littlefs) and :lfs_config on the include path.
+exports_files(["zephyr_lfs_crc.c"])
