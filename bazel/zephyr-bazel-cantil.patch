+# wolfCrypt (wolfcrypt/src/). Excludes async.c, misc.c, selftest.c — those are
+# #included by other units, not compiled directly. FIPS / ARMASM / INTELASM
+# sources are omitted (those CONFIG_* are off for this target).
+_WOLFCRYPT_SRCS = [
+    "wolfcrypt/src/hmac.c",
+    "wolfcrypt/src/random.c",
+    "wolfcrypt/src/kdf.c",
+    "wolfcrypt/src/rsa.c",
+    "wolfcrypt/src/ecc.c",
