#
# Noise_XX session handshake conformance, incl. Cacophony test vectors.
# Mirrors firmware/tests/noise_session/CMakeLists.txt (scripts/test.sh stays the
# reference runner). See //firmware/tests:ztest.bzl.

load("@rules_cc//cc:defs.bzl", "cc_library")
load("//firmware/tests:ztest.bzl", "cantil_ztest", "CBOR_DEPS", "CBOR_SRCS", "WOLFSSL_DEPS")

package(default_visibility = ["//visibility:public"])

# The Noise loopback harness is shared with //firmware/tests/session_chain,
# which builds it as a source (CMake: set(NOISE ../noise_session/src)).
exports_files(["src/loopback.c"])

cc_library(
    name = "loopback_headers",
    testonly = True,
    hdrs = glob(["src/*.h"]),
    includes = ["src"],
)

cantil_ztest(
    name = "noise_session",
    srcs = [
        "src/main.c",
        "src/main_cacophony.c",
        "src/loopback.c",
        "src/test_inject.c",
        "//firmware:src/session/session.c",
        "//firmware:src/session/noise_crypto_wolfssl.c",
        "//firmware:src/crypto/wc_rand.c",
        "//firmware:src/crypto/zeroize.c",
    ] + CBOR_SRCS,
    deps = [
        "//firmware:fw_session_headers",
    ] + WOLFSSL_DEPS + CBOR_DEPS,
)
