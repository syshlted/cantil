#
# Session-slot recovery conformance on native_sim.
# Mirrors firmware/tests/session_recovery/CMakeLists.txt (scripts/test.sh stays the
# reference runner). See //firmware/tests:ztest.bzl.

load("//firmware/tests:ztest.bzl", "cantil_ztest", "STORAGE_DEPS", "CA_SRCS", "CBOR_DEPS", "CBOR_SRCS", "CRYPTO_SRCS", "STORAGE_SRCS", "WOLFSSL_DEPS")

package(default_visibility = ["//visibility:public"])

cantil_ztest(
    name = "session_recovery",
    srcs = [
        "src/main.c",
        "//firmware:session_x509_constant",
        "//firmware:src/session/session_slot.c",
        "//firmware:src/session/noise_crypto_wolfssl.c",
    ] + CA_SRCS + CRYPTO_SRCS + STORAGE_SRCS + CBOR_SRCS,
    deps = WOLFSSL_DEPS + STORAGE_DEPS + CBOR_DEPS,
)
