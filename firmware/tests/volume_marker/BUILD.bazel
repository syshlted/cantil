#
# Volume identity marker conformance on native_sim.
# Mirrors firmware/tests/volume_marker/CMakeLists.txt (scripts/test.sh stays the
# reference runner). See //firmware/tests:ztest.bzl.

load("//firmware/tests:ztest.bzl", "cantil_ztest", "STORAGE_DEPS", "STORAGE_SRCS", "WOLFSSL_DEPS")

package(default_visibility = ["//visibility:public"])

cantil_ztest(
    name = "volume_marker",
    srcs = [
        "src/main.c",
        "//firmware:src/crypto/crypto_wolfssl.c",
        "//firmware:src/crypto/wc_rand.c",
        "//firmware:src/crypto/zeroize.c",
        "//firmware:src/crypto/device_id.c",
    ] + STORAGE_SRCS,
    deps = WOLFSSL_DEPS + STORAGE_DEPS,
)
