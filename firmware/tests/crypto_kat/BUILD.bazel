#
# Crypto known-answer tests for the wolfCrypt backend.
# Mirrors firmware/tests/crypto_kat/CMakeLists.txt (scripts/test.sh stays the
# reference runner). See //firmware/tests:ztest.bzl.

load("//firmware/tests:ztest.bzl", "cantil_ztest", "WOLFSSL_DEPS")

package(default_visibility = ["//visibility:public"])

cantil_ztest(
    name = "crypto_kat",
    srcs = [
        "src/main.c",
        "//firmware:src/crypto/crypto_wolfssl.c",
        "//firmware:src/crypto/zeroize.c",
        "//firmware:src/crypto/wc_rand.c",
        "//firmware:src/crypto/device_id.c",
    ],
    deps = [
        "//firmware:fw_crypto_headers",
    ] + WOLFSSL_DEPS,
)
