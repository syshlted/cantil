#
# Noise crypto primitive conformance for the wolfCrypt backend.
# Mirrors firmware/tests/noise_crypto/CMakeLists.txt (scripts/test.sh stays the
# reference runner). See //firmware/tests:ztest.bzl.

load("//firmware/tests:ztest.bzl", "cantil_ztest", "WOLFSSL_DEPS")

package(default_visibility = ["//visibility:public"])

cantil_ztest(
    name = "noise_crypto",
    srcs = [
        "src/main.c",
        "//firmware:src/session/noise_crypto_wolfssl.c",
        "//firmware:src/crypto/zeroize.c",
        "//firmware:src/crypto/wc_rand.c",
    ],
    deps = [
        "//firmware:fw_session_headers",
    ] + WOLFSSL_DEPS,
)
